# ============ Supabase (PostgreSQL) ============
# Project: App-Oficina del Barbero (ref: djfqlctpcchadjaxcvcb)
# Replace [PASSWORD] with the database password you set when creating the
# Supabase project. If you forgot it: Supabase panel -> Project Settings ->
# Database -> Reset database password.
#
# If these hosts don't match yours, copy the exact URIs from:
#   Project Settings -> Database -> Connection string
#   (Transaction pooler -> DATABASE_URL with ?pgbouncer=true; Direct -> DIRECT_URL)
DATABASE_URL="postgresql://postgres.djfqlctpcchadjaxcvcb:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.djfqlctpcchadjaxcvcb.supabase.co:5432/postgres"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
PUBLIC_BASE_URL="http://localhost:4000"

# Email (SMTP) - leave blank to fall back to console logging in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="App Barber <no-reply@appbarber.com>"

# Twilio (WhatsApp / SMS) - leave blank to fall back to console logging in dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_SMS_FROM=

# How often (cron expression) the reminder dispatcher checks for due reminders
REMINDER_CRON="*/5 * * * *"

# Optional: Postgres database used by `npm test` (tests wipe it between runs —
# NEVER point this at your real Supabase project). Leave unset to skip DB tests.
TEST_DATABASE_URL=
