# Database (SQLite file for dev; point to Postgres in production)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
PUBLIC_BASE_URL="http://localhost:4000"

# Email (SMTP) - leave blank to fall back to console logging in dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="App Barber <no-reply@appbarber.com>"

# Twilio (WhatsApp / SMS) - leave blank to fall back to console logging in dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_SMS_FROM=

# How often (cron expression) the reminder dispatcher checks for due reminders
REMINDER_CRON="*/5 * * * *"
