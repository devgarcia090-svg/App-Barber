# Point this at your backend. When testing with Expo Go on a phone over the
# same WiFi as your computer, use your computer's LAN IP (not localhost),
# e.g. http://192.168.1.23:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# This app is single-tenant: the client-facing booking flow always books
# against this one business, identified by its public slug.
EXPO_PUBLIC_BUSINESS_SLUG=oficina-del-barbero
